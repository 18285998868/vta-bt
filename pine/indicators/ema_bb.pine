//@version=6
// EMA + Bollinger Bands 指标, 只画线+带, 不下单

indicator("EMA + Bollinger Bands", overlay=true)

// ── Inputs ─────────────────────────────────────────────
ema_len   = input.int(20, "EMA Length", minval=1)
ma_type   = input.string("EMA", "MA Type", options=["SMA", "EMA", "WMA", "DEMA", "TEMA", "RMA", "VWMA", "TMA", "ZLEMA", "HMA"])
bb_len    = input.int(20, "BB Length", minval=1)
bb_mult   = input.float(2.0, "BB StdDev Multiplier", minval=0.1, step=0.1)
src       = input.source(close, "Source")
Atr = input.int(5, "Atr Period", minval=1, maxval=500)
Mult = input.float(2.5, "ATR Multiplier", minval=0.1)
ext_len = input.int(2, "极值止损周期", minval=1)

// ── MA 类型选择器 ───────────────────────────────────────
f_wma(_src, _len) =>
    num = 0.0
    den = 0.0
    for i = 0 to _len - 1
        w = _len - i
        num += nz(_src[i]) * w
        den += w
    num / den

f_rma(_src, _len) =>
    var float r = na
    if na(r)
        r := ta.sma(_src, _len)
    else
        r := (r * (_len - 1) + _src) / _len
    r

_ema1 = ta.ema(src, ema_len)
_ema2 = ta.ema(_ema1, ema_len)
_ema3 = ta.ema(_ema2, ema_len)
_sma  = ta.sma(src, ema_len)
_hma_half = math.max(1, int(ema_len / 2))
_hma_sqrt = math.max(1, int(math.sqrt(ema_len)))
_hma = f_wma(2 * f_wma(src, _hma_half) - f_wma(src, ema_len), _hma_sqrt)
ma_val = ma_type == "SMA" ? _sma :
     ma_type == "WMA" ? f_wma(src, ema_len) :
     ma_type == "DEMA" ? 2 * _ema1 - _ema2 :
     ma_type == "TEMA" ? 3 * _ema1 - 3 * _ema2 + _ema3 :
     ma_type == "RMA" ? f_rma(src, ema_len) :
     ma_type == "VWMA" ? ta.vwma(src, ema_len) :
     ma_type == "TMA" ? ta.sma(_sma, ema_len) :
     ma_type == "ZLEMA" ? ta.ema(src + (src - src[int((ema_len - 1) / 2)]), ema_len) :
     ma_type == "HMA" ? _hma : _ema1

// ── Bollinger Bands ────────────────────────────────────
bb_basis = ta.sma(src, bb_len)
bb_dev   = bb_mult * ta.stdev(src, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

// ── ATR Stop（棘轮式: 下方线只上移, 上方线只下移）──
atr_val = ta.atr(Atr)
var float atr_lower = na
var float atr_upper = na
new_lower = close - Mult * atr_val
new_upper = close + Mult * atr_val

// 下轨: 跌破时重置, 否则只上移
if not na(atr_lower) and close < atr_lower
    atr_lower := new_lower
else if na(atr_lower) or new_lower > atr_lower
    atr_lower := new_lower

// 上轨: 突破时重置, 否则只下移
if not na(atr_upper) and close > atr_upper
    atr_upper := new_upper
else if na(atr_upper) or new_upper < atr_upper
    atr_upper := new_upper

// ── Plot ───────────────────────────────────────────────
plot(ma_val, "MA", color.orange, 2)
p_basis = plot(bb_basis, "BB Basis", color.blue, 1)
p_upper = plot(bb_upper, "BB Upper", color.blue, 1)
p_lower = plot(bb_lower, "BB Lower", color.blue, 1)
fill(p_upper, p_lower, color=color.new(color.blue, 90), title="BB Fill")
plot(atr_upper, "ATR Upper Stop", color.red, 2)
plot(atr_lower, "ATR Lower Stop", color.red, 2)
// ── 过去 n 根K线极值止损（紫色, 与ATR同粗细）──
ext_high = ta.highest(high, ext_len)
ext_low  = ta.lowest(low, ext_len)
plot(ext_high, "Upper Extreme Stop", color.purple, 2)
plot(ext_low,  "Lower Extreme Stop", color.purple, 2)
