//@version=6
// SSF-ST Indicator — 对照实盘信号用, 只画线+标记, 不下单
//
// 与 Rust 实现逐行对齐:
//   ../../../nutilustrader/strategies/src/indicators/average/ssf_st.rs
//   ../../../nutilustrader/strategies/src/ssf_st_limit_hedge/strategy.rs (信号判定)
// 注意: 旧 pine(ssf_st_strategy.pine)的3极系数是Ehlers旧版(sqrt3),
// 现行Rust已对齐vta/vector-ta用1.738 (ssf_st.rs:74-81), 此处用新版。
//
// 信号 (strategy.rs:1327-1333):
//   Buy  : prev_close < prev_ssf && close >= ssf
//   Sell : prev_close > prev_ssf && close <= ssf

indicator("SSF-ST", overlay=true)

// ── Inputs ─────────────────────────────────────────────────────────────
period_i = input.int(3, "Period", minval=1)
poles_i  = input.int(2, "Poles", minval=2, maxval=3)

// ── State (ssf_st.rs:28-31) ────────────────────────────────────────────
var float val   = na
var float prev1 = na
var float prev2 = na
var float prev3 = na
var int   cnt   = 0
var bool  inited = false

// ── Coefficients ───────────────────────────────────────────────────────
var float b1 = na
var float a2 = na
var float c1 = na
var float c2 = na
var float c3 = na
var float c4 = na
var float c1c = na

if bar_index == 0
    if poles_i == 2
        // ssf_st.rs:49-52
        x = math.pi * math.sqrt(2.0) / period_i
        b1 := 2.0 * math.exp(-x) * math.cos(x)
        a2 := -math.exp(-2.0 * x)
        c1 := 1.0 - b1 - a2
    else
        // ssf_st.rs:74-81 (1.738, 与 vta 对齐)
        inv_p = 1.0 / period_i
        a = math.exp(-math.pi * inv_p)
        b = 2.0 * a * math.cos(1.738 * math.pi * inv_p)
        c = a * a
        c4  := c * c
        c3  := -c - b * c
        c2  := c + b
        c1c := 1.0 - c2 - c3 - c4

// ── Update (MovingAverage::update_raw, ssf_st.rs:151-195) ───────────────
if na(val)
    // 首根: value = prev1 = prev2 = prev3 = close
    val   := close
    prev1 := close
    prev2 := close
    prev3 := close
    cnt   := 1
else
    cnt := cnt + 1
    float out = na
    if poles_i == 2
        if cnt < 2
            out := close
            prev1 := close
        else
            out := c1 * close + b1 * prev1 + a2 * prev2
            prev2 := prev1
            prev1 := out
    else
        if cnt < 3
            out := close
            prev3 := prev2
            prev2 := prev1
            prev1 := close
        else
            out := c1c * close + c2 * prev1 + c3 * prev2 + c4 * prev3
            prev3 := prev2
            prev2 := prev1
            prev1 := out
    val := out

if not inited and cnt >= period_i
    inited := true

// ── Signals ────────────────────────────────────────────────────────────
prev_close = close[1]
prev_ssf   = val[1]

buy  = inited and not na(prev_ssf) and prev_close < prev_ssf and close >= val
sell = inited and not na(prev_ssf) and prev_close > prev_ssf and close <= val

// ── Plot ───────────────────────────────────────────────────────────────
plot(val, "SSF-ST", color.blue, 2)
plotshape(buy,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Buy")
plotshape(sell, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Sell")

if buy
    alert("SSF-ST Buy " + syminfo.ticker + " " + timeframe.period + " close=" + str.tostring(close), alert.freq_once_per_bar_close)
if sell
    alert("SSF-ST Sell " + syminfo.ticker + " " + timeframe.period + " close=" + str.tostring(close), alert.freq_once_per_bar_close)
