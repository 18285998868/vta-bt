//@version=6
// ATR Stoploss 指标, 只画线, 不下单
// 棘轮式: 下方线只上移, 上方线只下移, 各自独立重置

indicator("Stoploss ATR", overlay=true)

// ── Inputs ─────────────────────────────────────────────
Atr  = input.int(14, "Atr Period", minval=1, maxval=500)
Mult = input.float(2.5, "ATR Multiplier", minval=0.1)
base_opt = input.string("close", "Base Price", options=["close", "hlc3", "extreme"])

// ── ATR Stop（棘轮式: 下方线只上移, 上方线只下移）──
atr_val = ta.atr(Atr)
var float atr_lower = na
var float atr_upper = na
// 基准价: close / 典型价hlc3 / 极值(下轨用high, 上轨用low)
base_lower = base_opt == "hlc3" ? hlc3 : base_opt == "extreme" ? high : close
base_upper = base_opt == "hlc3" ? hlc3 : base_opt == "extreme" ? low : close
new_lower = base_lower - Mult * atr_val
new_upper = base_upper + Mult * atr_val

// 下轨: 跌破时重置, 否则只上移
if not na(atr_lower) and close < atr_lower
    atr_lower := new_lower
else if na(atr_lower) or new_lower > atr_lower
    atr_lower := new_lower

// 上轨: 突破时重置, 否则只下移
if not na(atr_upper) and close > atr_upper
    atr_upper := new_upper
else if na(atr_upper) or new_upper < atr_upper
    atr_upper := new_upper

// ── Plot（方向着色: 下轨上升绿/否则红, 上轨下降绿/否则红）──
lowerColor = atr_lower >= atr_lower[1] ? color.red : color.white
upperColor = atr_upper <= atr_upper[1] ? color.red : color.white
plot(atr_upper, "ATR Upper Stop", upperColor, 2)
plot(atr_lower, "ATR Lower Stop", lowerColor, 2)
