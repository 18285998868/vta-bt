//@version=6
// Relative ATR 指标: atr_short / atr_long, 短期波动率相对长期基线的强弱
// >1.2 淡绿背景, <0.8 淡红背景

indicator("Relative ATR", overlay=false)

// ── Inputs ─────────────────────────────────────────────
atr_short_len = input.int(5, "ATR Short Length", minval=1)
atr_long_len  = input.int(20, "ATR Long Length", minval=1)

// ── Relative ATR ───────────────────────────────────────
atr_short = ta.atr(atr_short_len)
atr_long  = ta.atr(atr_long_len)
atr_ratio = atr_long == 0 ? na : atr_short / atr_long

// ── Background ─────────────────────────────────────────
bgcolor(atr_ratio > 1.2 ? color.new(color.green, 85) : atr_ratio < 0.8 ? color.new(color.red, 85) : na, title="Relative ATR Background")

// ── Plot ───────────────────────────────────────────────
plot(atr_ratio, "Relative ATR", color.blue, 2)
hline(1.2, "1.2", color.gray)
hline(0.8, "0.8", color.gray)
hline(1.0, "1.0", color.gray)
