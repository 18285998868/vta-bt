//@version=6
// MA Band: 在 MA All 基础上叠加可选带宽
// MA: TV官方MA写法, Method下拉集成所有TV均线 + vector-ta 单均线(自适应均线见 adaptive_ma.pine)
// Band: 勾选式, 可同时显示标准差(stdev) / ATR / 百分比(MA*%), 默认只显示百分比
// 非Length参数取vector-ta默认: ATMA down=Length2, Tilson vfactor,
//   SSF_ST poles, DMA ema_length=20/gain=50, EDMA offset=0用plot位移

indicator(title="MA Band", shorttitle="MA Band", overlay=true, timeframe="", timeframe_gaps=true)

// ── Inputs (TV官方结构) ──────────────────────────────────
length  = input.int(20, "Length", minval=1, group="MA Settings")
src     = input.source(close, "Source", group="MA Settings")
offset  = input.int(0, "Offset", minval=-500, maxval=500, group="MA Settings")
method  = input.string("EMA", "Method", options=["SMA", "EMA", "WMA", "DEMA", "TEMA", "SMMA (RMA)", "VWMA", "HMA", "TMA", "TRIMA", "ZLEMA", "Wilders", "ALMA", "LinReg", "DMA", "EDMA", "EHMA", "FWMA", "PWMA", "SGMA", "SinWMA", "SSF", "SSF_ST", "SWMA", "Tilson", "ATMA"], group="MA Settings")
// ── 扩展参数 (仅对应方法生效) ────────────────────────────
length2 = input.int(20, "ATMA Down Length", minval=1, group="Advanced")
vfactor = input.float(0.7, "Tilson Volume Factor", minval=0.0, maxval=1.0, group="Advanced")
poles   = input.int(2, "SSF_ST Poles (2/3)", minval=2, maxval=3, group="Advanced")

// ── Band Inputs ─────────────────────────────────────────
show_std  = input.bool(false, "Standard Deviation Band", group="Band Settings")
std_mult  = input.float(2.0, "StdDev Multiplier", minval=0.1, step=0.1, group="Band Settings")
std_len   = input.int(20, "StdDev Length", minval=1, group="Band Settings")
show_atr  = input.bool(false, "ATR Band", group="Band Settings")
atr_mult  = input.float(2.0, "ATR Multiplier", minval=0.1, step=0.1, group="Band Settings")
atr_len   = input.int(14, "ATR Length", minval=1, group="Band Settings")
show_pct  = input.bool(true, "Percent Band", group="Band Settings")
pct       = input.float(2.0, "Percent (%)", minval=0.01, step=0.1, group="Band Settings")
fill_band = input.bool(true, "Fill Band", group="Band Settings")

// ── 基础helper ───────────────────────────────────────────
f_wma(_src, _len) =>
    num = 0.0
    den = 0.0
    for i = 0 to _len - 1
        w = _len - i
        num += nz(_src[i]) * w
        den += w
    num / den

f_rma(_src, _len) =>
    var float r = na
    if na(r)
        r := ta.sma(_src, _len)
    else
        r := (r * (_len - 1) + _src) / _len
    r

// ── DEMA/TEMA/ZLEMA ──────────────────────────────────────
f_dema(_src, _len) =>
    e1 = ta.ema(_src, _len)
    e2 = ta.ema(e1, _len)
    2 * e1 - e2

f_tema(_src, _len) =>
    e1 = ta.ema(_src, _len)
    e2 = ta.ema(e1, _len)
    e3 = ta.ema(e2, _len)
    3 * e1 - 3 * e2 + e3

f_zlema(_src, _len) =>
    lag = int((_len - 1) / 2)
    ta.ema(_src + (_src - _src[lag]), _len)

// ── TMA/TRIMA ────────────────────────────────────────────
f_tma(_src, _len) =>
    ta.sma(ta.sma(_src, _len), _len)

f_trima(_src, _len) =>
    ta.sma(ta.sma(ta.sma(_src, _len), _len), _len)

// ── ATMA: SMA(up)/SMA(down)加权 ──────────────────────────
f_atma(_src, _up, _down) =>
    su = ta.sma(_src, _up)
    sd = ta.sma(_src, _down)
    (su * _up + sd * _down) / (_up + _down)

// ── EHMA: Hann窗加权 ─────────────────────────────────────
f_ehma(_src, _len) =>
    num = 0.0
    for k = 0 to _len - 1
        w = 1.0 - math.cos(2.0 * math.pi * (k + 1) / (_len + 1))
        num += nz(_src[_len - 1 - k]) * w
    num / (_len + 1)

// ── FWMA: Fibonacci权重 ──────────────────────────────────
f_fwma(_src, _len) =>
    fa = 1.0
    fb = 1.0
    num = 0.0
    den = 0.0
    for k = 0 to _len - 1
        w = k == 0 ? 1.0 : fb
        num += nz(_src[_len - 1 - k]) * w
        den += w
        fn = fa + fb
        fa := fb
        fb := fn
    num / den

// ── PWMA: Pascal(二项式)权重 ─────────────────────────────
f_pwma(_src, _len) =>
    c = 1.0
    num = 0.0
    den = 0.0
    n = _len - 1
    for k = 0 to _len - 1
        if k > 0
            c := c * (n - k + 1) / k
        num += nz(_src[_len - 1 - k]) * c
        den += c
    num / den

// ── SinWMA: 正弦权重 ─────────────────────────────────────
f_sinwma(_src, _len) =>
    num = 0.0
    den = 0.0
    for k = 0 to _len - 1
        w = math.sin((k + 1) * math.pi / (_len + 1))
        num += nz(_src[_len - 1 - k]) * w
        den += w
    num / den

// ── SWMA: 对称三角权重 ───────────────────────────────────
f_swma(_src, _len) =>
    m = int((_len + 1) / 2)
    num = 0.0
    den = 0.0
    for k = 0 to _len - 1
        w = k < m ? k + 1.0 : (_len - k) * 1.0
        num += nz(_src[_len - 1 - k]) * w
        den += w
    num / den

// ── Tilson T3 ────────────────────────────────────────────
f_t3(_src, _len, _vf) =>
    e1 = ta.ema(_src, _len)
    e2 = ta.ema(e1, _len)
    e3 = ta.ema(e2, _len)
    e4 = ta.ema(e3, _len)
    e5 = ta.ema(e4, _len)
    e6 = ta.ema(e5, _len)
    c1 = -_vf * _vf * _vf
    c2 = 3 * _vf * _vf + 3 * _vf * _vf * _vf
    c3 = -6 * _vf * _vf - 3 * _vf - 3 * _vf * _vf * _vf
    c4 = 1 + 3 * _vf + _vf * _vf * _vf + 3 * _vf * _vf
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

// ── SSF: Ehlers SuperSmoother 2极 ────────────────────────
f_ssf(_src, _len) =>
    a1 = math.exp(-1.414 * math.pi / _len)
    b1 = 2.0 * a1 * math.cos(1.414 * math.pi / _len)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1.0 - c2 - c3
    var float s = na
    s := c1 * (_src + _src[1]) / 2 + c2 * nz(s[1]) + c3 * nz(s[2])
    s

// ── SSF_ST: 2/3极 (与ssf_st_indicator.pine一致) ──────────
f_ssf_st(_src, _len, _poles) =>
    var float val = na
    var float p1 = na
    var float p2 = na
    var float p3 = na
    var int cnt = 0
    var float b1 = na
    var float a2 = na
    var float c2 = na
    var float c3 = na
    var float c4 = na
    var float c1c = na
    first = na(val)
    if first
        if _poles == 2
            x = math.pi * math.sqrt(2.0) / _len
            b1 := 2.0 * math.exp(-x) * math.cos(x)
            a2 := -math.exp(-2.0 * x)
        else
            inv = 1.0 / _len
            a = math.exp(-math.pi * inv)
            b = 2.0 * a * math.cos(1.738 * math.pi * inv)
            c = a * a
            c4 := c * c
            c3 := -c - b * c
            c2 := c + b
            c1c := 1.0 - c2 - c3 - c4
        val := _src
        p1 := _src
        p2 := _src
        p3 := _src
        cnt := 1
    else
        cnt := cnt + 1
        float out = na
        if _poles == 2
            if cnt < 2
                out := _src
                p1 := _src
            else
                out := (1.0 - b1 - a2) * _src + b1 * p1 + a2 * p2
                p2 := p1
                p1 := out
        else
            if cnt < 3
                out := _src
                p3 := p2
                p2 := p1
                p1 := _src
            else
                out := c1c * _src + c2 * p1 + c3 * p2 + c4 * p3
                p3 := p2
                p2 := p1
                p1 := out
        val := out
    val

// ── DMA (Jurik结构: Hull + 增益受限ECORR, ema=20/gain=50) ─
f_dma(_src, _hl) =>
    _el = 20
    _gl = 50
    alpha = 2.0 / (_el + 1)
    oma = 1.0 - alpha
    half = math.max(1, int(_hl / 2))
    sq = math.max(1, int(math.round(math.sqrt(_hl))))
    var float e0 = na
    var float ec = na
    e0 := na(e0[1]) ? ta.sma(_src, _el) : alpha * _src + oma * nz(e0[1])
    e0v = nz(e0, _src)
    ecPrev = nz(ec[1], e0v)
    dx = _src - ecPrev
    t = alpha * dx
    base = alpha * e0v + oma * ecPrev
    r = _src - base
    g = 0.0
    if t != 0
        best = 10.0
        bg = 0.0
        for gi = 0 to _gl
            gg = gi * 0.1
            e = math.abs(r - t * gg)
            if e < best
                best := e
                bg := gg
        g := bg
    ec := alpha * (e0v + g * dx) + oma * ecPrev
    hull = ta.wma(2 * ta.wma(_src, half) - ta.wma(_src, _hl), sq)
    (hull + ec) / 2

// ── SGMA: Savitzky-Golay端点二次拟合 ─────────────────────
f_sgma(_src, _len) =>
    n = _len
    sx = 0.0
    sx2 = 0.0
    sx3 = 0.0
    sx4 = 0.0
    sy = 0.0
    sxy = 0.0
    sx2y = 0.0
    for k = 0 to n - 1
        x = k * 1.0
        y = nz(_src[n - 1 - k])
        x2 = x * x
        sx += x
        sx2 += x2
        sx3 += x2 * x
        sx4 += x2 * x2
        sy += y
        sxy += x * y
        sx2y += x2 * y
    det = n * (sx2 * sx4 - sx3 * sx3) - sx * (sx * sx4 - sx3 * sx2) + sx2 * (sx * sx3 - sx2 * sx2)
    xe = (n - 1) * 1.0
    out = ta.sma(_src, n)
    if det != 0
        d0 = sy * (sx2 * sx4 - sx3 * sx3) - sx * (sxy * sx4 - sx3 * sx2y) + sx2 * (sxy * sx3 - sx2 * sx2y)
        d1 = n * (sxy * sx4 - sx3 * sx2y) - sy * (sx * sx4 - sx3 * sx2) + sx2 * (sx * sx2y - sxy * sx2)
        d2 = n * (sx2 * sx2y - sxy * sx3) - sx * (sx * sx2y - sxy * sx2) + sy * (sx * sx3 - sx2 * sx2)
        out := d0 / det + d1 / det * xe + d2 / det * xe * xe
    out

// ── 方法分发 ─────────────────────────────────────────────
float ma = na
if method == "SMA"
    ma := ta.sma(src, length)
else if method == "EMA"
    ma := ta.ema(src, length)
else if method == "WMA"
    ma := ta.wma(src, length)
else if method == "DEMA"
    ma := f_dema(src, length)
else if method == "TEMA"
    ma := f_tema(src, length)
else if method == "SMMA (RMA)"
    ma := ta.rma(src, length)
else if method == "VWMA"
    ma := ta.vwma(src, length)
else if method == "HMA"
    ma := ta.hma(src, length)
else if method == "TMA"
    ma := f_tma(src, length)
else if method == "TRIMA"
    ma := f_trima(src, length)
else if method == "ZLEMA"
    ma := f_zlema(src, length)
else if method == "Wilders"
    ma := ta.rma(src, length)
else if method == "ALMA"
    ma := ta.alma(src, length, 0.85, 6)
else if method == "LinReg"
    ma := ta.linreg(src, length, 0)
else if method == "DMA"
    ma := f_dma(src, length)
else if method == "EDMA"
    ma := ta.ema(src, length)
else if method == "EHMA"
    ma := f_ehma(src, length)
else if method == "FWMA"
    ma := f_fwma(src, length)
else if method == "PWMA"
    ma := f_pwma(src, length)
else if method == "SGMA"
    ma := f_sgma(src, length)
else if method == "SinWMA"
    ma := f_sinwma(src, length)
else if method == "SSF"
    ma := f_ssf(src, length)
else if method == "SSF_ST"
    ma := f_ssf_st(src, length, poles)
else if method == "SWMA"
    ma := f_swma(src, length)
else if method == "Tilson"
    ma := f_t3(src, length, vfactor)
else if method == "ATMA"
    ma := f_atma(src, length, length2)

plot(ma, title="MA", color=color.blue, linewidth=2, offset=offset)

// ── Band ────────────────────────────────────────────────
// 带宽无条件计算, 勾选只控制是否绘制
std_w = std_mult * ta.stdev(src, std_len)
atr_w = atr_mult * ta.atr(atr_len)
pct_w = ma * pct / 100.0

std_up = ma + std_w
std_dn = ma - std_w
atr_up = ma + atr_w
atr_dn = ma - atr_w
pct_up = ma + pct_w
pct_dn = ma - pct_w

// 标准差带
p_std_up = plot(show_std ? std_up : na, title="StdDev Upper", color=color.new(color.blue, 40), linewidth=1, offset=offset)
p_std_dn = plot(show_std ? std_dn : na, title="StdDev Lower", color=color.new(color.blue, 40), linewidth=1, offset=offset)
fill(p_std_up, p_std_dn, color=fill_band ? color.new(color.blue, 90) : na, title="StdDev Fill")

// ATR 带
p_atr_up = plot(show_atr ? atr_up : na, title="ATR Upper", color=color.new(color.orange, 40), linewidth=1, offset=offset)
p_atr_dn = plot(show_atr ? atr_dn : na, title="ATR Lower", color=color.new(color.orange, 40), linewidth=1, offset=offset)
fill(p_atr_up, p_atr_dn, color=fill_band ? color.new(color.orange, 90) : na, title="ATR Fill")

// 百分比带
p_pct_up = plot(show_pct ? pct_up : na, title="Percent Upper", color=color.new(color.purple, 40), linewidth=1, offset=offset)
p_pct_dn = plot(show_pct ? pct_dn : na, title="Percent Lower", color=color.new(color.purple, 40), linewidth=1, offset=offset)
fill(p_pct_up, p_pct_dn, color=fill_band ? color.new(color.purple, 90) : na, title="Percent Fill")
