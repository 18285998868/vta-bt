//@version=6
// Bollinger Bands 指标, 只画线+带, 不下单

indicator("Bollinger Bands", overlay=true)

// ── Inputs ─────────────────────────────────────────────
bb_len  = input.int(20, "BB Length", minval=1)
bb_mult = input.float(2.0, "BB StdDev Multiplier", minval=0.1, step=0.1)
src     = input.source(close, "Source")

// ── Bollinger Bands ────────────────────────────────────
bb_basis = ta.sma(src, bb_len)
bb_dev   = bb_mult * ta.stdev(src, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

// ── Plot ───────────────────────────────────────────────
p_basis = plot(bb_basis, "BB Basis", color.blue, 1)
p_upper = plot(bb_upper, "BB Upper", color.blue, 1)
p_lower = plot(bb_lower, "BB Lower", color.blue, 1)
fill(p_upper, p_lower, color=color.new(color.blue, 90), title="BB Fill")
