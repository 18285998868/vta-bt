//@version=6
// HMA Strategy — Hull Moving Average Crossover
//
// Signal logic:
//   Long  : prev_close < prev_HMA  && close >= HMA    (price crosses above HMA)
//   Short : prev_close > prev_HMA  && close <= HMA    (price crosses below HMA)
//
// Position management:
//   - Flips existing position in the opposite direction
//   - Enters new position if flat
//   - No pyramiding (one position at a time)
//
// Order sizing:
//   100% of equity (percent_of_equity) — fills at any symbol price.
//   Fixed qty (0.1 unit) is borderline/rejected on high-priced symbols
//   (BTC ≈ $80k/unit vs $10k capital) → no trades shown on chart.

strategy("HMA Strategy",
         overlay=true,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.04)

// ── Inputs ─────────────────────────────────────────────────────────────
period_i = input.int(3, "HMA Period", minval=1)

// ── HMA Calculation ────────────────────────────────────────────────────
hma_val = ta.hma(close, period_i)

// ── Signals ────────────────────────────────────────────────────────────
prev_close = close[1]
prev_hma   = hma_val[1]

buy  = not na(prev_hma) and prev_close < prev_hma and close >= hma_val
sell = not na(prev_hma) and prev_close > prev_hma and close <= hma_val

// ── Order Management ───────────────────────────────────────────────────
if buy
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip→Long")
    strategy.entry("Long", strategy.long, comment="Long")

if sell
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip→Short")
    strategy.entry("Short", strategy.short, comment="Short")

// ── Visualization ──────────────────────────────────────────────────────
plot(hma_val, "HMA", color.blue, 2)
plot(close,   "Close", color.gray, 1)

plotshape(buy,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(sell, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Short Signal")
