//@version=6
// =============================================================================
// VWAP-MR-002 · 日内 VWAP 均值回归（基线）
// -----------------------------------------------------------------------------
// 设计文档：docs/均值回归/vwap-intraday-mean-reversion-strategy.md
//
// 与 VWAP-001 的结构性区别：
//   1) 不在“偏离后首次收回”入场；先等衰竭 setup（3 根内量高潮 + 拒绝影线），
//      再等二次确认（收复 setup bar 中点 + 同向收盘）。
//   2) 开仓前有 regime gate：ADX、VWAP 斜率、session 穿越次数、ATR regime、流动性。
//   3) 只做 2.0σ–3.0σ 的极端；超过 3.0σ 不新开，3.5σ 止损。
//   4) 止盈回 VWAP；结构+ATR 硬止损、z 止损、regime 退出、时间止损、EOD。
//   5) 按风险百分比定仓，20% 名义上限，无杠杆，日亏损/连亏断路器。
//
// 2026-11 修订（v0.2，信号普查后）：
//   - 原版要求“同根放量 + 同根长影 + 同根 2σ”，6.5 个月 BTC 5m 仅 1 个 setup、0 笔入场；
//     普查显示 90% 极值 bar 死于影线条件，83% 死于 24 根穿越≥2，81% 死于 ADX<25。
//   - 改为：高潮可回看 3 根；影线阈值按 range 0.35、收盘不贴最低 25%；
//     session 内穿越≥1 只否决单边趋势日；ADX 上限 30，退出 35（留迟滞）；
//     确认只要求收复中点，z 余量放宽到 1.0，剩余空间交给 edgeBps。
//   - 结构修正后同口径信号：BTC 5m 26 笔、BTC 15m 18 笔、ETH 5m 24 笔
//     （Binance 现货频率代理，仅证明有样本，不是收益）。
//
// 执行假设：
//   - 信号用收盘价判定，市价单下一根开盘成交（process_orders_on_close=false）。
//   - 止损是 strategy.exit stop 单，盘中生效。
//   - 只用已收盘 bar；calc_on_every_tick=false；不用 request.security。
//   - 不建模 funding 成本，只做 07:45–08:15 / 15:45–16:15 UTC 的 funding 黑窗；
//     不建模 spread / 延迟；Pine 只用于形状检查，不是判局证据。
//   - 本地没有 Pine 编译器，未在 TradingView 实际编译；首次加载按文档 9.6 排查。
// =============================================================================

// 成本：Pine 的 commission/slippage 参数必须是 const，不能用 input 改；
// 要改成本，直接改下面 strategy() 里的 commission_value / slippage。
strategy("VWAP-MR-002 Intraday Mean Reversion",
     shorttitle      = "VWAP-MR-002",
     overlay         = true,
     pyramiding      = 0,
     initial_capital = 100000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.04,   // 单边 4 bp，偏保守的 taker 假设
     slippage           = 2,      // 2 tick
     margin_long        = 100,
     margin_short       = 100,
     max_bars_back      = 5000,
     calc_on_every_tick = false,
     process_orders_on_close = false)

// ─────────────────────────────── 输入 ───────────────────────────────
grpS = "Session / 时段"
useTimeFilter   = input.bool(true,  "启用时段过滤", group = grpS)
startMinute     = input.int(420,  "开始分钟（UTC，420=07:00）", minval = 0, maxval = 1439, group = grpS)
endMinute       = input.int(1320, "结束分钟（UTC，1320=22:00）", minval = 0, maxval = 1439, group = grpS)
lastEntryMinute = input.int(1320, "最后开仓分钟（UTC）", minval = 0, maxval = 1439, group = grpS)
eodFlatMinute   = input.int(1425, "EOD 平仓分钟（UTC，1425=23:45）", minval = 0, maxval = 1439, group = grpS)
minWarmupHours  = input.float(2.0, "VWAP 预热（小时）", minval = 0.5, maxval = 12.0, step = 0.5, group = grpS)
warmupBars      = input.int(24, "VWAP 预热（根）", minval = 4, maxval = 200, group = grpS)
useFundingBlackout = input.bool(true, "funding 黑窗（07:45–08:15 / 15:45–16:15 UTC）", group = grpS)

grpZ = "VWAP / z"
atrLen          = input.int(14, "ATR 长度", minval = 2, group = grpZ)
sigmaFloorAtr   = input.float(0.5, "σ 下限（×ATR）", minval = 0.1, maxval = 2.0, step = 0.05, group = grpZ)
zEntry          = input.float(2.0, "入场 |z|", minval = 1.0, maxval = 5.0, step = 0.1, group = grpZ)
zMaxEntry       = input.float(3.0, "最大入场 |z|", minval = 1.5, maxval = 5.0, step = 0.1, group = grpZ)
zStop           = input.float(3.5, "z 止损", minval = 2.0, maxval = 6.0, step = 0.1, group = grpZ)
zExit           = input.float(0.0, "止盈 z（0=VWAP）", minval = 0.0, maxval = 2.0, step = 0.1, group = grpZ)
zConfirmSlack   = input.float(1.0, "确认时 z 余量", minval = 0.0, maxval = 2.0, step = 0.1, group = grpZ)
minEdgeBps      = input.float(25.0, "最小毛边（bp）", minval = 0.0, maxval = 200.0, step = 1.0, group = grpZ)
maxSigmaPct     = input.float(1.5, "σ/C 上限（%）", minval = 0.2, maxval = 5.0, step = 0.1, group = grpZ)

grpR = "Regime"
adxLen          = input.int(14, "ADX 长度", minval = 2, group = grpR)
adxSmooth       = input.int(14, "ADX 平滑", minval = 2, group = grpR)
// 跑参数网格时同步把 adxExit 设为 adxMax+5，保持 5 点迟滞（25/30、30/35、35/40）。
adxMax          = input.float(30.0, "入场 ADX 上限", minval = 5.0, maxval = 60.0, step = 1.0, group = grpR)
adxExit         = input.float(35.0, "持仓 ADX 退出", minval = 5.0, maxval = 70.0, step = 1.0, group = grpR)
slopeLen        = input.int(12, "VWAP 斜率窗口", minval = 2, group = grpR)
slopeMax        = input.float(0.6, "入场 |slope| 上限（ATR）", minval = 0.1, maxval = 3.0, step = 0.05, group = grpR)
slopeExit       = input.float(0.9, "持仓 |slope| 退出", minval = 0.1, maxval = 4.0, step = 0.05, group = grpR)
minSessionCross = input.int(1, "session 内最少穿越 VWAP", minval = 0, maxval = 20, group = grpR)
atrRegimeLen    = input.int(96, "ATR regime 基准长度", minval = 10, group = grpR)
atrRegimeMin    = input.float(0.5, "ATR/ATR基准 下限", minval = 0.1, maxval = 2.0, step = 0.05, group = grpR)
atrRegimeMax    = input.float(3.0, "ATR/ATR基准 上限", minval = 1.0, maxval = 10.0, step = 0.1, group = grpR)
liqLen          = input.int(96, "流动性基准长度", minval = 10, group = grpR)
liqMinRatio     = input.float(0.25, "流动性下限（×基准）", minval = 0.0, maxval = 2.0, step = 0.05, group = grpR)
maxConfirmRangeAtr = input.float(2.5, "确认 bar 最大振幅（×ATR）", minval = 0.5, maxval = 10.0, step = 0.1, group = grpR)

grpE = "衰竭 / 确认"
volLen          = input.int(20, "成交量均线", minval = 2, group = grpE)
volMult         = input.float(1.8, "成交量高潮倍数", minval = 0.5, maxval = 5.0, step = 0.1, group = grpE)
climaxLookback  = input.int(3, "成交量高潮回看（根）", minval = 1, maxval = 10, group = grpE)
wickMult        = input.float(0.35, "影线占 range 比例", minval = 0.1, maxval = 0.95, step = 0.05, group = grpE)
closeFloor      = input.float(0.25, "收盘离开极值（×range）", minval = 0.0, maxval = 0.5, step = 0.05, group = grpE)
confirmBars     = input.int(3, "确认窗口（根）", minval = 1, maxval = 10, group = grpE)
invalidAtr      = input.float(0.15, "失效缓冲（×ATR）", minval = 0.0, maxval = 1.0, step = 0.05, group = grpE)

grpX = "出场 / 风险"
stopAtr         = input.float(1.0, "ATR 硬止损", minval = 0.2, maxval = 5.0, step = 0.1, group = grpX)
stopBufAtr      = input.float(0.15, "结构止损缓冲（×ATR）", minval = 0.0, maxval = 1.0, step = 0.05, group = grpX)
minStopAtr      = input.float(0.6, "最小止损距离（×ATR）", minval = 0.1, maxval = 2.0, step = 0.05, group = grpX)
maxStopAtr      = input.float(2.5, "最大止损距离（×ATR）", minval = 0.5, maxval = 6.0, step = 0.1, group = grpX)
maxBars         = input.int(48, "时间止损（根）", minval = 2, maxval = 500, group = grpX)
riskPct         = input.float(0.5, "单笔风险（%权益，硬上限 1%）", minval = 0.05, maxval = 1.0, step = 0.05, group = grpX)
maxNotionalPct  = input.float(20.0, "名义上限（%权益，研究上限 30%）", minval = 1.0, maxval = 30.0, step = 1.0, group = grpX)
minNotional     = input.float(100.0, "最小名义（USDT）", minval = 1.0, step = 10.0, group = grpX)
dailyMaxR       = input.float(2.0, "日亏损上限（×日风险预算）", minval = 0.5, maxval = 10.0, step = 0.5, group = grpX)
maxConsecLoss   = input.int(3, "最大连续亏损", minval = 1, maxval = 20, group = grpX)
maxTradesPerDay = input.int(6, "单日最大交易数", minval = 1, maxval = 50, group = grpX)
cooldownBars    = input.int(3, "亏损后冷却（根）", minval = 0, maxval = 100, group = grpX)
maxAccountDD    = input.float(10.0, "账户回撤 kill switch（%）", minval = 1.0, maxval = 50.0, step = 1.0, group = grpX)

grpD = "显示"
showBands       = input.bool(true, "显示 VWAP ±zEntry/±zStop σ", group = grpD)
showMarkers     = input.bool(true, "显示 setup/entry/exit", group = grpD)
showPanel       = input.bool(true, "显示调试面板", group = grpD)

// ─────────────────────────────── 基础序列 ───────────────────────────────
int tfSec = timeframe.in_seconds(timeframe.period)
bool intradayOK = timeframe.isintraday and tfSec <= 900
float tp = hlc3
float vol = nz(volume, 0.0)

// UTC 日界：VWAP 在 00:00 UTC 重置
int curDay = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
var int lastDay = na
bool newSession = na(lastDay) or curDay != lastDay
lastDay := curDay

var int barsSinceOpen = 0
if newSession
    barsSinceOpen := 0
else
    barsSinceOpen += 1

// ─────────────────────────────── Session VWAP / σ / z ───────────────────────────────
var float cumPV  = 0.0
var float cumV   = 0.0
var float cumPV2 = 0.0

if newSession
    cumPV  := 0.0
    cumV   := 0.0
    cumPV2 := 0.0

if vol > 0
    cumPV  += tp * vol
    cumV   += vol
    cumPV2 += tp * tp * vol

float vwap = cumV > 0 ? cumPV / cumV : na
float varp = cumV > 0 ? cumPV2 / cumV - vwap * vwap : na
float sigmaRaw = varp > 0 ? math.sqrt(varp) : na

float atrVal = ta.atr(atrLen)
float sigma = na(atrVal) ? na : math.max(nz(sigmaRaw, 0.0), sigmaFloorAtr * atrVal)
float z = not na(vwap) and not na(sigma) and sigma > 0 ? (close - vwap) / sigma : na
float edgeBps = not na(z) and not na(sigma) and close > 0 ? math.abs(z) * sigma / close * 10000.0 : na
float sigmaPct = not na(sigma) and close > 0 ? sigma / close * 100.0 : na

// ─────────────────────────────── Regime ───────────────────────────────
float atrMa = ta.sma(atrVal, atrRegimeLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmooth)
float vwapSlope = not na(vwap) and not na(vwap[slopeLen]) and not na(atrVal) and atrVal > 0 ? (vwap - vwap[slopeLen]) / atrVal : na

float dev = not na(vwap) ? close - vwap : na
bool crossUp = not na(dev) and not na(dev[1]) and dev > 0 and dev[1] <= 0
bool crossDn = not na(dev) and not na(dev[1]) and dev < 0 and dev[1] >= 0
// session 内穿越次数：只否决“从未回踩 VWAP”的单边趋势日，不做 24 根窗口的硬约束。
// 旧版“24 根内穿越≥2 + 当前 2σ 偏离”在逻辑上互斥，是信号归零的主因之一。
var int sessionCrosses = 0
if newSession
    sessionCrosses := 0
if (crossUp or crossDn) and not newSession
    sessionCrosses += 1

bool adxOK = not na(adxVal) and adxVal < adxMax
bool slopeOK = not na(vwapSlope) and math.abs(vwapSlope) <= slopeMax
bool crossOK = sessionCrosses >= minSessionCross
bool regimeOK = adxOK and slopeOK and crossOK
bool regimeExit = (not na(adxVal) and adxVal >= adxExit) or (not na(vwapSlope) and math.abs(vwapSlope) >= slopeExit)

bool volRegimeOK = not na(atrMa) and atrMa > 0 and not na(atrVal) and atrVal >= atrRegimeMin * atrMa and atrVal <= atrRegimeMax * atrMa

// 流动性代理：美元成交额相对基准；Pine 拿不到盘口 spread
float dollarVol = close * vol
float liqMa = ta.sma(dollarVol, liqLen)
bool liqOK = not na(liqMa) and liqMa > 0 and dollarVol >= liqMinRatio * liqMa

// 成交量高潮：允许在最近 climaxLookback 根内出现；基准均量整体后移，避免窗口自我稀释
float volBase = ta.sma(vol, volLen)[climaxLookback]
bool volClimax = not na(volBase) and volBase > 0 and ta.highest(vol, climaxLookback) >= volMult * volBase

// K 线解剖：影线按 range 计，收盘只需离开极值 closeFloor，不要求收在上/下半部
float rng = high - low
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
bool bullWick = rng > 0 and lowerWick >= wickMult * rng and close >= low + closeFloor * rng
bool bearWick = rng > 0 and upperWick >= wickMult * rng and close <= high - closeFloor * rng
bool confirmRangeOK = not na(atrVal) and atrVal > 0 and rng <= maxConfirmRangeAtr * atrVal

// ─────────────────────────────── 时段 / 预热 ───────────────────────────────
int barCloseTime = time + tfSec * 1000
int minuteOfDay = hour(time, "UTC") * 60 + minute(time, "UTC")
int closeMinute = hour(barCloseTime, "UTC") * 60 + minute(barCloseTime, "UTC")

bool inTimeWindow = not useTimeFilter or (minuteOfDay >= startMinute and minuteOfDay < endMinute)
// Binance U 本位 funding 在 00:00/08:00/16:00 UTC；这里只做“禁止新开仓”的黑窗，不建模 funding 成本。
bool fundingBlackout = useFundingBlackout and ((closeMinute >= 465 and closeMinute < 495) or (closeMinute >= 945 and closeMinute < 975))
bool entryTimeOK = inTimeWindow and closeMinute < lastEntryMinute and not fundingBlackout
bool eodFlat = timeframe.isintraday and closeMinute >= eodFlatMinute

float warmupSec = math.max(minWarmupHours * 3600.0, warmupBars * tfSec)
bool warmupOK = barsSinceOpen * tfSec >= warmupSec

// ─────────────────────────────── 日风险状态 ───────────────────────────────
var float initialEquity = na
var float dayStartEquity = na
var float dayStartNetProfit = na
var float dayRiskCash = na
var int dayTrades = 0
var int consecLoss = 0
var int lastClosedCount = 0
var int lastExitBar = na

if na(initialEquity)
    initialEquity := strategy.equity

if newSession
    dayStartEquity := strategy.equity
    dayStartNetProfit := strategy.netprofit
    dayRiskCash := dayStartEquity * riskPct / 100.0
    dayTrades := 0
    consecLoss := 0
    lastExitBar := na

// 已平仓交易归因：只用于连亏/冷却；日亏损用净利差
if strategy.closedtrades > lastClosedCount
    for i = lastClosedCount to strategy.closedtrades - 1
        float p = strategy.closedtrades.profit(i)
        if p < 0
            consecLoss += 1
            lastExitBar := bar_index
        else
            consecLoss := 0
    lastClosedCount := strategy.closedtrades

float dayLossR = not na(dayStartNetProfit) and not na(dayRiskCash) and dayRiskCash > 0 ? (dayStartNetProfit - strategy.netprofit) / dayRiskCash : 0.0
bool dayBlocked = dayLossR >= dailyMaxR or consecLoss >= maxConsecLoss
bool tradesOK = dayTrades < maxTradesPerDay
bool cooldownOK = true
if not na(lastExitBar)
    cooldownOK := bar_index - lastExitBar >= cooldownBars
bool ddOK = not na(initialEquity) and strategy.equity >= initialEquity * (1.0 - maxAccountDD / 100.0)

bool canTrade = intradayOK and not dayBlocked and tradesOK and cooldownOK and ddOK and entryTimeOK and not eodFlat

// ─────────────────────────────── 状态变量 ───────────────────────────────
var int setupDir = 0          // 1 long, -1 short, 0 none
var int setupBar = na
var float setupLow = na
var float setupHigh = na
var float setupMid = na

var float entryPx = na
var float stopPx = na
var float riskDist = na
var int posBar = na

bool flat = strategy.position_size == 0
bool isLong = strategy.position_size > 0
bool isShort = strategy.position_size < 0

// ─────────────────────────────── 开仓门 ───────────────────────────────
bool vwapOK = not na(vwap) and not na(sigma) and sigma > 0
bool zOK = not na(z)
bool sigmaOK = not na(sigmaPct) and sigmaPct <= maxSigmaPct
bool edgeOK = zOK and vwapOK and not na(edgeBps) and edgeBps >= minEdgeBps
bool entryGate = canTrade and warmupOK and regimeOK and volRegimeOK and liqOK and edgeOK and sigmaOK

// 信号漏斗：只用于诊断“信号死在哪一层”，不参与交易逻辑
bool zExtremeBar = flat and warmupOK and canTrade and zOK and math.abs(z) >= zEntry and math.abs(z) <= zMaxEntry
bool gatePassBar = zExtremeBar and entryGate

// 衰竭 setup：只武装，不立刻入场
bool longSetup = false
bool shortSetup = false
if flat and entryGate and zOK
    longSetup := z <= -zEntry and z >= -zMaxEntry and volClimax and bullWick
    shortSetup := z >= zEntry and z <= zMaxEntry and volClimax and bearWick

bool newSetupSignal = (longSetup or shortSetup) and setupDir == 0

if longSetup and setupDir == 0
    setupDir := 1
    setupBar := bar_index
    setupLow := low
    setupHigh := high
    setupMid := (high + low) / 2.0

if shortSetup and setupDir == 0
    setupDir := -1
    setupBar := bar_index
    setupLow := low
    setupHigh := high
    setupMid := (high + low) / 2.0

// 持仓时不保留 setup，避免平仓后用过期的确认
if not flat and setupDir != 0
    setupDir := 0
    setupBar := na

int setupAge = 0
if setupDir != 0 and not na(setupBar)
    setupAge := bar_index - setupBar

bool longInvalid = false
bool shortInvalid = false
if setupDir == 1 and setupAge > 0
    longInvalid := setupAge > confirmBars or (not na(atrVal) and close < setupLow - invalidAtr * atrVal)
if setupDir == -1 and setupAge > 0
    shortInvalid := setupAge > confirmBars or (not na(atrVal) and close > setupHigh + invalidAtr * atrVal)

bool longConfirm = false
bool shortConfirm = false
if setupDir == 1 and setupAge >= 1 and setupAge <= confirmBars and not longInvalid and entryGate and confirmRangeOK and not na(setupMid)
    longConfirm := close > setupMid and close > open and zOK and z >= -zMaxEntry and z <= -zEntry + zConfirmSlack
if setupDir == -1 and setupAge >= 1 and setupAge <= confirmBars and not shortInvalid and entryGate and confirmRangeOK and not na(setupMid)
    shortConfirm := close < setupMid and close < open and zOK and z <= zMaxEntry and z >= zEntry - zConfirmSlack

// 失效后清空；确认/入场也会清空
if longInvalid or shortInvalid
    setupDir := 0
    setupBar := na
    setupLow := na
    setupHigh := na
    setupMid := na

// ─────────────────────────────── 止损 / 仓位 ───────────────────────────────
float riskCash = strategy.equity * riskPct / 100.0

float stopLongRaw = not na(atrVal) and not na(setupLow) ? math.min(setupLow - stopBufAtr * atrVal, close - stopAtr * atrVal) : na
float riskLongRaw = not na(stopLongRaw) ? close - stopLongRaw : na
float stopLong = not na(riskLongRaw) and not na(atrVal) and riskLongRaw < minStopAtr * atrVal ? close - minStopAtr * atrVal : stopLongRaw
float riskLong = not na(stopLong) ? close - stopLong : na
bool longRiskOK = not na(riskLong) and riskLong > 0 and not na(atrVal) and riskLong <= maxStopAtr * atrVal

float stopShortRaw = not na(atrVal) and not na(setupHigh) ? math.max(setupHigh + stopBufAtr * atrVal, close + stopAtr * atrVal) : na
float riskShortRaw = not na(stopShortRaw) ? stopShortRaw - close : na
float stopShort = not na(riskShortRaw) and not na(atrVal) and riskShortRaw < minStopAtr * atrVal ? close + minStopAtr * atrVal : stopShortRaw
float riskShort = not na(stopShort) ? stopShort - close : na
bool shortRiskOK = not na(riskShort) and riskShort > 0 and not na(atrVal) and riskShort <= maxStopAtr * atrVal

float qtyLongRisk = longRiskOK ? riskCash / riskLong : 0.0
float qtyLongCap = close > 0 ? strategy.equity * maxNotionalPct / 100.0 / close : 0.0
float qtyLong = math.min(qtyLongRisk, qtyLongCap)
bool qtyLongOK = not na(qtyLong) and qtyLong > 0 and qtyLong * close >= minNotional

float qtyShortRisk = shortRiskOK ? riskCash / riskShort : 0.0
float qtyShortCap = close > 0 ? strategy.equity * maxNotionalPct / 100.0 / close : 0.0
float qtyShort = math.min(qtyShortRisk, qtyShortCap)
bool qtyShortOK = not na(qtyShort) and qtyShort > 0 and qtyShort * close >= minNotional

bool longEntrySignal = flat and longConfirm and longRiskOK and qtyLongOK
bool shortEntrySignal = flat and shortConfirm and shortRiskOK and qtyShortOK

// ─────────────────────────────── 入场 ───────────────────────────────
if longEntrySignal
    strategy.entry("Long", strategy.long, qty = qtyLong, comment = "VWAP-MR 多")
    // 同一根提交保护性 stop，避免成交 bar 盘中裸奔
    strategy.exit("SL Long", "Long", stop = stopLong, comment_loss = "结构止损")
    stopPx := stopLong
    riskDist := riskLong
    entryPx := close
    dayTrades += 1
    setupDir := 0
    setupBar := na
    setupLow := na
    setupHigh := na
    setupMid := na

if shortEntrySignal
    strategy.entry("Short", strategy.short, qty = qtyShort, comment = "VWAP-MR 空")
    strategy.exit("SL Short", "Short", stop = stopShort, comment_loss = "结构止损")
    stopPx := stopShort
    riskDist := riskShort
    entryPx := close
    dayTrades += 1
    setupDir := 0
    setupBar := na
    setupLow := na
    setupHigh := na
    setupMid := na

// 成交后记录持仓起点与实际均价（用于时间止损/面板）
if strategy.position_size != 0 and strategy.position_size[1] == 0
    posBar := bar_index
    entryPx := strategy.position_avg_price

// ─────────────────────────────── 出场 ───────────────────────────────
int barsHeld = (isLong or isShort) and not na(posBar) ? bar_index - posBar : 0

bool longTp = isLong and zOK and z >= zExit
bool shortTp = isShort and zOK and z <= -zExit

bool longZStop = isLong and zOK and z <= -zStop
bool shortZStop = isShort and zOK and z >= zStop

bool longTimeStop = isLong and barsHeld >= maxBars
bool shortTimeStop = isShort and barsHeld >= maxBars

bool longRegimeExit = isLong and regimeExit
bool shortRegimeExit = isShort and regimeExit

bool longEod = isLong and eodFlat
bool shortEod = isShort and eodFlat

// 硬止损：每根都提交，stop 单盘中有效
if isLong and not na(stopPx)
    strategy.exit("SL Long", "Long", stop = stopPx, comment_loss = "结构止损")
if isShort and not na(stopPx)
    strategy.exit("SL Short", "Short", stop = stopPx, comment_loss = "结构止损")

// 收盘确认类出场：优先级 EOD > z 止损 > regime > 时间 > 止盈
if longEod
    strategy.close("Long", comment = "EOD 平仓")
else if longZStop
    strategy.close("Long", comment = "z 止损")
else if longRegimeExit
    strategy.close("Long", comment = "regime 退出")
else if longTimeStop
    strategy.close("Long", comment = "时间止损")
else if longTp
    strategy.close("Long", comment = "回归 VWAP")

if shortEod
    strategy.close("Short", comment = "EOD 平仓")
else if shortZStop
    strategy.close("Short", comment = "z 止损")
else if shortRegimeExit
    strategy.close("Short", comment = "regime 退出")
else if shortTimeStop
    strategy.close("Short", comment = "时间止损")
else if shortTp
    strategy.close("Short", comment = "回归 VWAP")

if eodFlat
    setupDir := 0
    setupBar := na

bool longExitAny = longEod or longZStop or longRegimeExit or longTimeStop or longTp
bool shortExitAny = shortEod or shortZStop or shortRegimeExit or shortTimeStop or shortTp

// ─────────────────────────────── 调试计数 ───────────────────────────────
var int cntZExtreme = 0
var int cntGatePass = 0
var int cntSetup = 0
var int cntConfirm = 0
var int cntEntry = 0
var int cntLongSetup = 0
var int cntShortSetup = 0
var int cntLongEntry = 0
var int cntShortEntry = 0
if zExtremeBar
    cntZExtreme += 1
if gatePassBar
    cntGatePass += 1
if newSetupSignal
    cntSetup += 1
if longConfirm or shortConfirm
    cntConfirm += 1
if longEntrySignal or shortEntrySignal
    cntEntry += 1
if newSetupSignal and longSetup
    cntLongSetup += 1
if newSetupSignal and shortSetup
    cntShortSetup += 1
if longEntrySignal
    cntLongEntry += 1
if shortEntrySignal
    cntShortEntry += 1

// ─────────────────────────────── 绘图 ───────────────────────────────
plot(showBands ? vwap : na, "VWAP", color.new(color.teal, 0), 2)
plot(showBands ? vwap + zEntry * sigma : na, "+zEntry σ", color.new(color.red, 40), 1)
plot(showBands ? vwap - zEntry * sigma : na, "-zEntry σ", color.new(color.green, 40), 1)
plot(showBands ? vwap + zStop * sigma : na, "+zStop σ", color.new(color.maroon, 50), 1)
plot(showBands ? vwap - zStop * sigma : na, "-zStop σ", color.new(color.maroon, 50), 1)

plotshape(showMarkers and longSetup, "Long setup", shape.circle, location.belowbar, color.new(color.green, 45), size = size.tiny)
plotshape(showMarkers and shortSetup, "Short setup", shape.circle, location.abovebar, color.new(color.red, 45), size = size.tiny)
plotshape(showMarkers and longEntrySignal, "Long entry", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(showMarkers and shortEntrySignal, "Short entry", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)
plotshape(showMarkers and longExitAny, "Long exit", shape.xcross, location.abovebar, color.new(color.gray, 0), size = size.tiny)
plotshape(showMarkers and shortExitAny, "Short exit", shape.xcross, location.belowbar, color.new(color.gray, 0), size = size.tiny)

bgcolor(dayBlocked ? color.new(color.red, 90) : na, title = "日断路器")
bgcolor(eodFlat ? color.new(color.gray, 92) : na, title = "EOD 窗口")

// ─────────────────────────────── 调试面板 ───────────────────────────────
fNum(_v) => na(_v) ? "—" : str.tostring(_v, "#.##")
fRow(_tb, _r, _k, _v) =>
    table.cell(_tb, 0, _r, _k, text_color = color.gray, text_size = size.small)
    table.cell(_tb, 1, _r, _v, text_color = color.white, text_size = size.small)

var table tb = table.new(position.top_right, 2, 17, border_width = 1)
if showPanel and barstate.islast
    table.cell(tb, 0, 0, "VWAP-MR-002", text_color = color.white, text_size = size.small, bgcolor = color.gray)
    table.cell(tb, 1, 0, intradayOK ? "intraday OK" : "仅 1m/3m/5m/15m", text_color = color.white, text_size = size.small, bgcolor = intradayOK ? color.new(color.green, 0) : color.new(color.red, 0))
    fRow(tb, 1, "VWAP / σ%", fNum(vwap) + " / " + fNum(sigmaPct))
    fRow(tb, 2, "z / edge bp", fNum(z) + " / " + fNum(edgeBps))
    fRow(tb, 3, "ADX / slope", fNum(adxVal) + " / " + fNum(vwapSlope))
    fRow(tb, 4, "session 穿越 / regime", str.tostring(sessionCrosses) + " / " + (regimeOK ? "OK" : "BLOCK"))
    fRow(tb, 5, "ATR / 基准", fNum(atrVal) + " / " + fNum(atrMa))
    fRow(tb, 6, "warmup / edge", (warmupOK ? "OK" : "WAIT") + " / " + (edgeOK ? "OK" : "LOW"))
    fRow(tb, 7, "setup / age", (setupDir == 1 ? "多" : setupDir == -1 ? "空" : "无") + " / " + str.tostring(setupAge))
    fRow(tb, 8, "持仓", isLong ? "多 " + str.tostring(strategy.position_size, "#.###") : isShort ? "空 " + str.tostring(strategy.position_size, "#.###") : "空仓")
    fRow(tb, 9, "入场 / 止损", (isLong or isShort) ? fNum(entryPx) + " / " + fNum(stopPx) : "—")
    fRow(tb, 10, "日亏损R / 连亏", fNum(dayLossR) + " / " + str.tostring(consecLoss))
    fRow(tb, 11, "日交易 / 总平仓", str.tostring(dayTrades) + " / " + str.tostring(strategy.closedtrades))
    fRow(tb, 12, "setup 信号 多/空", str.tostring(cntLongSetup) + " / " + str.tostring(cntShortSetup))
    fRow(tb, 13, "入场信号 多/空", str.tostring(cntLongEntry) + " / " + str.tostring(cntShortEntry))
    fRow(tb, 14, "漏斗 z / gate", str.tostring(cntZExtreme) + " / " + str.tostring(cntGatePass))
    fRow(tb, 15, "setup / confirm / entry", str.tostring(cntSetup) + " / " + str.tostring(cntConfirm) + " / " + str.tostring(cntEntry))
    fRow(tb, 16, "版本", "v0.2 · 2026-11 结构修订")

// ─────────────────────────────── 预警 ───────────────────────────────
alertcondition(longEntrySignal, "VWAP-MR Long", "VWAP-MR-002：多头 setup 二次确认，下一根开盘入场")
alertcondition(shortEntrySignal, "VWAP-MR Short", "VWAP-MR-002：空头 setup 二次确认，下一根开盘入场")
alertcondition(longExitAny, "VWAP-MR Long Exit", "VWAP-MR-002：多头离场")
alertcondition(shortExitAny, "VWAP-MR Short Exit", "VWAP-MR-002：空头离场")
