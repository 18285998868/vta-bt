//@version=6
// SSF_ST Strategy — Ehlers Super Smoother Filter (Original) Crossover
//
// Translated from the Rust live-trading strategy:
//   ../../../nutilustrader/strategies/src/ssf/strategy.rs
//   ../../../nutilustrader/strategies/src/indicators/average/ssf_st.rs
//
// Signal logic (strategy.rs:134-140):
//   Long  : prev_close < prev_SSF  && close >= SSF    (price crosses above SSF)
//   Short : prev_close > prev_SSF  && close <= SSF    (price crosses below SSF)
//
// Position management (strategy.rs:142-163):
//   - Flips existing position in the opposite direction
//   - Enters new position if flat
//   - No pyramiding (one position at a time)

strategy("SSF_ST Strategy",
         overlay=true,
         default_qty_type=strategy.fixed,
         default_qty_value=0.1,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.04)

// ── Inputs ─────────────────────────────────────────────────────────────
period_i    = input.int(3, "SSF Period", minval=1)
poles_i     = input.int(2, "Poles", minval=2, maxval=3)
size_i      = input.float(0.1, "Trade Size (BTC)", step=0.01)

// ── SSF State ──────────────────────────────────────────────────────────
var float ssf_val  = na
var float fil_prev1 = na
var float fil_prev2 = na
var float fil_prev3 = na
var int   fil_cnt   = 0

// ── SSF Coefficients (computed once on first bar) ──────────────────────
var float b1      = na
var float a2      = na
var float c1      = na
var float c1_coef = na
var float c2      = na
var float c3      = na
var float c4      = na

var bool  initialized = false

if bar_index == 0
    if poles_i == 2
        // 2-pole coefficients (ssf_st.rs:41-45)
        x = math.pi * math.sqrt(2.0) / period_i
        b1 := 2.0 * math.exp(-x) * math.cos(x)
        a2 := -math.exp(-2.0 * x)
        c1 := 1.0 - b1 - a2
    else
        // 3-pole coefficients (ssf_st.rs:66-73)
        x = math.pi / period_i
        a0   = math.exp(-x)
        b0   = 2.0 * a0 * math.cos(math.sqrt(3.0) * x)
        c0   = math.exp(-2.0 * x)
        c4  := math.exp(-4.0 * x)
        c3  := -c0 * (1.0 + b0)
        c2  := c0 + b0
        c1_coef := 1.0 - c2 - c3 - c4

// ── Main Logic ─────────────────────────────────────────────────────────
// Capture previous bar's values before updating (strategy.rs:120-121)
prev_close = close[1]
prev_ssf   = ssf_val[1]

// ── SSF Update (inlined — Pine cannot modify global var in function) ───
if na(fil_prev1)
    fil_prev1 := close
    fil_prev2 := close
    fil_prev3 := close
    fil_cnt   := 1
    ssf_val   := close
else
    fil_cnt := fil_cnt + 1
    float result = 0.0
    if poles_i == 2
        // 2-pole filter (ssf_st.rs:155-163)
        if fil_cnt < 2
            result := close
        else
            result := c1 * close + b1 * fil_prev1 + a2 * fil_prev2
    else
        // 3-pole filter (ssf_st.rs:165-178)
        if fil_cnt < 3
            result := close
        else
            result := c1_coef * close + c2 * fil_prev1 + c3 * fil_prev2 + c4 * fil_prev3
    // Shift delay line (ssf_st.rs:161-162, 175-177)
    fil_prev3 := fil_prev2
    fil_prev2 := fil_prev1
    fil_prev1 := result
    ssf_val   := result

// Mark initialized once we have enough bars
if not initialized and fil_cnt >= period_i
    initialized := true

// ── Signals (strategy.rs:134-140) ──────────────────────────────────────
buy  = initialized and not na(prev_ssf) and not na(prev_close) and prev_close < prev_ssf and close >= ssf_val

sell = initialized and not na(prev_ssf) and not na(prev_close) and prev_close > prev_ssf and close <= ssf_val

// ── Order Management (strategy.rs:142-163) ─────────────────────────────
if buy
    if strategy.position_size < 0  // has short → flip
        strategy.close("Short", comment="Flip→Long")
    strategy.entry("Long", strategy.long, qty=size_i, comment="Long")

if sell
    if strategy.position_size > 0  // has long → flip
        strategy.close("Long", comment="Flip→Short")
    strategy.entry("Short", strategy.short, qty=size_i, comment="Short")

// ── Visualization ──────────────────────────────────────────────────────
plot(ssf_val, "SSF", color.blue, 2)
plot(close,   "Close", color.gray, 1)

plotshape(buy,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(sell, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Short Signal")
