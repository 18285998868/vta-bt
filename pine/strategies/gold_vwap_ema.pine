//@version=6
// Gold VWAP-EMA Regime Strategy — Bhatti (2026) SSRN-6650958
//
// 人话逻辑见同目录 gold_vwap_ema.md
//
// 规则还原 (XAU/USD 15m):
//   Regime: close>EMA200=多, close<EMA200=空, 距EMA200<0.1%不开
//   VWAP  : NY 13:30-20:00 UTC自算, 多需Ct>VWAP, 空需Ct<VWAP
//   入场  : 回踩50EMA + pin/吞没 + 量>1.1*MA20(V) + 波幅>=0.8*ATR14
//   初损  : Lsignal-0.5*ATR / Hsignal+0.5*ATR (盘中有效, 唯一看影线处)
//   出场  : 只看收盘! 收盘破50EMA走, 浮盈>=2.5R切20EMA, 目标3R
//   风控  : 1%风险仓位, 单日-3R停, 新闻手动开关
//
// Pine实现说明:
//   - strategy calc_on_every_tick=false => 拖尾天然close-only, 影线穿无视
//   - process_orders_on_close=true => 信号bar收盘成交, 贴近论文收盘确认
//   - VWAP用tick volume自算, 无量品种自动退化(vol=1)
//   - 新闻exclusion为手动输入开关, Pine拿不到财经日历

strategy("Gold VWAP-EMA Regime",
         overlay=true,
         pyramiding=0,
         default_qty_type=strategy.fixed,
         default_qty_value=1.0,
         initial_capital=10000,
         process_orders_on_close=true,
         calc_on_every_tick=false,
         commission_type=strategy.commission.cash_per_contract,
         commission_value=0.5)

// ── Inputs ─────────────────────────────────────────────────────────────
emaFastLen_i  = input.int(50, "EMA Fast (入场+拖尾)", minval=2)
emaSlowLen_i  = input.int(200, "EMA Slow (Regime)", minval=2)
emaFinalLen_i = input.int(20, "EMA Final (末段收紧)", minval=2)
atrLen_i      = input.int(14, "ATR Len", minval=1)
atrMult_i     = input.float(0.5, "ATR Mult (初损=0.5ATR)", step=0.1)
volLen_i      = input.int(20, "Volume MA Len", minval=2)
volMult_i     = input.float(1.1, "Volume Mult", step=0.05)
rangeMult_i   = input.float(0.8, "Range Mult (波幅过滤)", step=0.05)
boundPct_i    = input.float(0.1, "EMA200边界模糊区%", step=0.05)
targetR_i     = input.float(3.0, "目标R", step=0.5)
finalR_i      = input.float(2.5, "末段收紧R", step=0.1)
riskPct_i     = input.float(1.0, "单笔风险%", step=0.25)
dailyMaxR_i   = input.float(3.0, "单日最大亏损R", step=0.5)
useVwapF_i    = input.bool(true, "启用VWAP过滤")
useVolF_i     = input.bool(true, "启用量确认")
useRangeF_i   = input.bool(true, "启用波幅过滤")
onlySession_i = input.bool(true, "仅NY Session交易")
usePartial_i  = input.bool(true, "VWAP compressed减半")
blockNews_i   = input.bool(false, "新闻模式(手动 блокировать 开单)")
sessStr_i     = input.session("1330-2000:1234567", "NY Session")
tz_i          = input.string("UTC", "Session时区")
relaxed_i     = input.bool(false, "宽松模式(调试: C4只要求收阳/阴)")
showDebug_i   = input.bool(true, "显示调试面板")

// ── Indicators ─────────────────────────────────────────────────────────
emaFast  = ta.ema(close, emaFastLen_i)
emaSlow  = ta.ema(close, emaSlowLen_i)
emaFinal = ta.ema(close, emaFinalLen_i)
atrVal   = ta.atr(atrLen_i)

// volume fallback: 无量品种用1代替, VWAP退化为均价
volUse   = nz(volume, 1.0)
volUse   := volUse <= 0 ? 1.0 : volUse
volMA    = ta.sma(volUse, volLen_i)

// ── NY Session VWAP (默认13:30-20:00 UTC) ──────────────────────────────────
tSess      = time(timeframe.period, sessStr_i, tz_i)
inSession  = not na(tSess)
newSession = inSession and not inSession[1]

var float cumPV = 0.0
var float cumV  = 0.0
tp          = hlc3
if newSession
    cumPV := tp * volUse
    cumV  := volUse
else if inSession
    cumPV += tp * volUse
    cumV  += volUse
else
    // 非交易时段不清零, 保持最后一根VWAP不断线(仅显示用)
    cumPV := cumPV
    cumV  := cumV

vwapVal = cumV > 0 ? cumPV / cumV : na
vwapOK  = not na(vwapVal)

// ── Candle anatomy ─────────────────────────────────────────────────────
body      = math.abs(close - open)
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
candleRng = high - low

pinBull = lowerWick >= 2 * body and upperWick <= 0.5 * lowerWick
pinBear = upperWick >= 2 * body and lowerWick <= 0.5 * upperWick
engBull = close > open[1] and open < close[1]
engBear = close < open[1] and open > close[1]
// 宽松模式: C4只要求收阳/收阴, 用于排查“信号过严导致0单”
rejBullStrict = pinBull or engBull
rejBearStrict = pinBear or engBear
rejBull = relaxed_i ? close > open : rejBullStrict
rejBear = relaxed_i ? close < open : rejBearStrict

volOK   = not useVolF_i or volUse > volMult_i * volMA
rangeOK = not useRangeF_i or candleRng >= rangeMult_i * atrVal

// ── Regime ─────────────────────────────────────────────────────────────
boundPct   = math.abs(close - emaSlow) / emaSlow * 100
inBoundary = boundPct < boundPct_i
bullRegime = close > emaSlow and not inBoundary
bearRegime = close < emaSlow and not inBoundary

vwapLongOK  = not useVwapF_i or (not na(vwapVal) and close > vwapVal)
vwapShortOK = not useVwapF_i or (not na(vwapVal) and close < vwapVal)

// C3: 回踩(碰过但收回)
touchBull = math.min(low, low[1]) <= emaFast and emaFast <= close
touchBear = math.max(high, high[1]) >= emaFast and emaFast >= close

sessOK = not onlySession_i or inSession

longSignal  = sessOK and bullRegime and vwapLongOK and touchBull and rejBull and volOK and rangeOK
shortSignal = sessOK and bearRegime and vwapShortOK and touchBear and rejBear and volOK and rangeOK

// ── State: entry/SL/target ─────────────────────────────────────────────
var float entryPx  = na
var float slPx     = na
var float riskDist = na
var float targetPx = na
var int   entryBar = -1
var float cumRangeEntry = 0.0
var bool  reduced  = false

// ── Daily loss limit (UTC日, R计) ──────────────────────────────────────
var int   dayId    = -1
var float dayR     = 0.0
var int   consecL  = 0
curDay = dayofmonth(time("D", "UTC")) + month(time("D", "UTC")) * 100
if dayId < 0 or curDay != dayId
    dayId := curDay
    dayR  := 0.0

// 已平仓交易的R归因: 用closedtrades profit / 该笔风险估算较重, 这里用净利/ATR近似
// 简化: 每笔平仓按 exit profit / (0.5*ATR at exit) 折R, 足够做断路器
if strategy.closedtrades > strategy.closedtrades[1]
    lastP = strategy.closedtrades.profit(strategy.closedtrades - 1)
    lastR = lastP / (0.5 * atrVal)
    dayR += lastR
    if lastR < 0
        consecL += 1
    else
        consecL := 0

dayBlocked = dayR <= -dailyMaxR_i or consecL >= 3
canTrade   = not dayBlocked and not blockNews_i

flat = strategy.position_size == 0

// ── Position sizing Eq.7: qty = riskCash / riskDist ────────────────────
riskCash = strategy.equity * riskPct_i / 100

longSL     = low - atrMult_i * atrVal
longRisk   = close - longSL
longTarget = close + targetR_i * longRisk
longQty    = longRisk > 0 ? riskCash / longRisk : 0.0
longQty    := math.max(longQty, 0.01)

shortSL     = high + atrMult_i * atrVal
shortRisk   = shortSL - close
shortTarget = close - targetR_i * shortRisk
shortQty    = shortRisk > 0 ? riskCash / shortRisk : 0.0
shortQty    := math.max(shortQty, 0.01)

// ── Entries ────────────────────────────────────────────────────────────
if longSignal and flat and canTrade
    strategy.entry("Long", strategy.long, qty=longQty, comment="多回踩")
    entryPx  := close
    slPx     := longSL
    riskDist := longRisk
    targetPx := longTarget
    entryBar := bar_index
    cumRangeEntry := 0.0
    reduced  := false
    strategy.exit("LongXB", "Long", stop=longSL, limit=longTarget, comment_profit="3R", comment_loss="初损")

if shortSignal and flat and canTrade
    strategy.entry("Short", strategy.short, qty=shortQty, comment="空回踩")
    entryPx  := close
    slPx     := shortSL
    riskDist := shortRisk
    targetPx := shortTarget
    entryBar := bar_index
    cumRangeEntry := 0.0
    reduced  := false
    strategy.exit("ShortXB", "Short", stop=shortSL, limit=shortTarget, comment_profit="3R", comment_loss="初损")

// 持仓中累计波幅(用于impulsive/compressed判定)
if not flat and entryBar >= 0
    cumRangeEntry += candleRng

isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0

// 浮动R
floatR = isLong ? (close - entryPx) / riskDist : isShort ? (entryPx - close) / riskDist : na

// ── VWAP milestone: compressed减半 ─────────────────────────────────────
nearVwap = not na(vwapVal) and math.abs(close - vwapVal) / vwapVal <= 0.0015
barsHeld = entryBar >= 0 ? bar_index - entryBar : 0
avgRngHeld = barsHeld > 0 ? cumRangeEntry / barsHeld : na

// compressed: 近5根都小波幅且都贴VWAP
compCount = 0
if barsHeld >= 5 and not na(vwapVal)
    compCount := 0
    for i = 0 to 4
        rOK = (high[i] - low[i]) <= 0.6 * atrVal[i]
        pOK = math.abs(close[i] - vwapVal) / vwapVal <= 0.0015
        if rOK and pOK
            compCount += 1

compressed = compCount >= 5
// impulsive: 持仓<=3根且均幅>1.0ATR (满足则不减仓, 注释即可)

if usePartial_i and not reduced and not flat and nearVwap and compressed
    if isLong
        strategy.close("Long", comment="VWAP减半", qty_percent=50)
    if isShort
        strategy.close("Short", comment="VWAP减半", qty_percent=50)
    reduced := true

// ── Trailing: close-only (calc_on_every_tick=false保证影线无视) ─────────
trailEMA = not na(floatR) and floatR >= finalR_i ? emaFinal : emaFast

exitLongTrail  = isLong and close < trailEMA
exitShortTrail = isShort and close > trailEMA

if exitLongTrail
    strategy.close("Long", comment="收盘破EMA走")
    entryPx  := na
    entryBar := -1
if exitShortTrail
    strategy.close("Short", comment="收盘破EMA走")
    entryPx  := na
    entryBar := -1

// 目标/初损由strategy.exit处理, 拖尾平仓后取消残留exit由Pine自动处理
// 平仓后重置
if flat
    entryPx  := na
    entryBar := -1

// ── Visualization ──────────────────────────────────────────────────────
plot(emaSlow, "EMA200 Regime", color.orange, 2)
plot(emaFast, "EMA50 入场+拖尾", color.blue, 2)
plot(emaFinal, "EMA20 末段", color.purple, 1)
plot(vwapOK ? vwapVal : na, "VWAP NY", color.teal, 2)

plotshape(longSignal, style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, title="Long Signal(raw)")
plotshape(shortSignal, style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, title="Short Signal(raw)")
plotshape(exitLongTrail or exitShortTrail, style=shape.xcross, location=location.top, color=color.gray, size=size.tiny, title="Trail Exit")

bgcolor(dayBlocked ? color.new(color.red, 85) : na, title="日断路")
bgcolor(not inSession and onlySession_i ? color.new(color.gray, 90) : na, title="非NY时段")
bgcolor(bullRegime ? color.new(color.green, 90) : bearRegime ? color.new(color.red, 90) : na, title="Regime")

// ── Debug panel: 哪个条件卡住了 ─────────────────────────────────────────
var table dbg = table.new(position.top_right, 2, 10, border_width=1)
if showDebug_i and barstate.islast
    nTot   = bar_index + 1
    nSess  = ta.cum(inSession ? 1 : 0)
    nBull  = ta.cum(bullRegime ? 1 : 0)
    nBear  = ta.cum(bearRegime ? 1 : 0)
    nTouch = ta.cum((touchBull or touchBear) ? 1 : 0)
    nRej   = ta.cum((rejBull or rejBear) ? 1 : 0)
    nVol   = ta.cum((volOK and rangeOK) ? 1 : 0)
    nLong  = ta.cum(longSignal ? 1 : 0)
    nShort = ta.cum(shortSignal ? 1 : 0)
    emaOK  = not na(emaSlow)
    table.cell(dbg, 0, 0, "EMA200预热", text_color=color.white, bgcolor=color.new(color.blue, 0))
    table.cell(dbg, 1, 0, emaOK ? "OK" : "数据不足(<200根)", text_color=color.white, bgcolor=emaOK ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(dbg, 0, 1, "总bar", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 1, str.tostring(nTot), text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 0, 2, "inSession bar", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 2, str.tostring(nSess), text_color=color.white, bgcolor=nSess > 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(dbg, 0, 3, "bull/bear bar", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 3, str.tostring(nBull) + "/" + str.tostring(nShort), text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 0, 4, "touch50 bar", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 4, str.tostring(nTouch), text_color=color.white, bgcolor=nTouch > 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(dbg, 0, 5, "rej bar(pin/吞没)", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 5, str.tostring(nRej), text_color=color.white, bgcolor=nRej > 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(dbg, 0, 6, "量+波幅通过bar", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 6, str.tostring(nVol), text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 0, 7, "long/short信号", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 7, str.tostring(nLong) + "/" + str.tostring(nShort), text_color=color.white, bgcolor=(nLong + nShort) > 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(dbg, 0, 8, "VWAP", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 8, vwapOK ? "OK" : "na(换Session/无量?)", text_color=color.white, bgcolor=vwapOK ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(dbg, 0, 9, "宽松模式", text_color=color.white, bgcolor=color.new(color.gray, 0))
    table.cell(dbg, 1, 9, relaxed_i ? "ON" : "OFF", text_color=color.white, bgcolor=color.new(color.gray, 0))
