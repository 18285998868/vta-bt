//@version=6
// Bollinger Breakout — Simple
//
// Signal logic:
//   Long entry  : close crosses over Upper (SMA + mult * Stdev)
//   Short entry : close crosses under Lower (SMA - mult * Stdev)
//   Entry filter: ATR(atr1) / ATR(atr2) > thr (volatility expansion, Wilder ATR)
//                 toggle via "Enable ATR Filter", default ON
//   Exit        : reverse entry condition (opposite breakout + same filters) — flips
//   Stop loss   : close-based: long closes below entry close - k * ATR(stopLen), short mirrored
//                 toggle via "Enable ATR Stop", default ON
//
// Order sizing:
//   100% of equity (percent_of_equity) — fills at any symbol price.
//   Fixed qty (e.g. 1) is rejected as insufficient funds on high-priced
//   symbols (BTC ≈ $80k/unit vs $10k capital) → no trades shown on chart.

strategy("Bollinger Breakout",
         overlay=true,
         pyramiding=0,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         initial_capital=10000,
         commission_type=strategy.commission.percent,
         commission_value=0.04)

// ── Inputs ─────────────────────────────────────────────────────────────
length_i    = input.int(20, "Length", minval=2)
mult_i      = input.float(2.0, "Mult", minval=0.1, step=0.1)
useFilter_i = input.bool(true, "Enable ATR Filter")
atr1_i      = input.int(5, "atr1 (Short ATR)", minval=1)
atr2_i      = input.int(20, "atr2 (Long ATR)", minval=2)
thrAtr_i    = input.float(1.2, "thr(atr) Entry Filter", minval=0.0, step=0.05)
useStop_i   = input.bool(true, "Enable ATR Stop")
stopLen_i   = input.int(14, "ATR Stop Length", minval=1)
kStop_i     = input.float(3.0, "K: ATR Stop Mult", minval=0.1, step=0.1)

// ── Bollinger Calculation ──────────────────────────────────────────────
basis = ta.sma(close, length_i)
dev   = mult_i * ta.stdev(close, length_i)
upper = basis + dev
lower = basis - dev

// ── ATR Expansion Filter: atr1/atr2 > thr ──────────────────────────────
atrShort = ta.atr(atr1_i)
atrLong  = ta.atr(atr2_i)
atrRatio = atrLong > 0 ? atrShort / atrLong : na
atrOK    = not useFilter_i or (not na(atrRatio) and atrRatio > thrAtr_i)

// ── Signals ────────────────────────────────────────────────────────────
// Exit mirrors entry: reverse breakout + same filters (see order management).
longBreak  = ta.crossover(close, upper) and atrOK
shortBreak = ta.crossunder(close, lower) and atrOK

// ── ATR Stop state: k * ATR, close-based ───────────────────────────────
atrStop = ta.atr(stopLen_i)
var float longStop  = na
var float shortStop = na

stopHitLong  = useStop_i and strategy.position_size > 0 and not na(longStop) and close < longStop
stopHitShort = useStop_i and strategy.position_size < 0 and not na(shortStop) and close > shortStop

// ── Order Management ───────────────────────────────────────────────────
// No mid-line exit — positions close on the reverse signal (flip) or the ATR stop.
if longBreak
    if strategy.position_size < 0
        strategy.close("Short", comment="Flip→Long")
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="Long")
        longStop := close - kStop_i * atrStop

if shortBreak
    if strategy.position_size > 0
        strategy.close("Long", comment="Flip→Short")
    if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="Short")
        shortStop := close + kStop_i * atrStop

if stopHitLong
    strategy.close("Long", comment="ATR止损")

if stopHitShort
    strategy.close("Short", comment="ATR止损")

// ── Visualization ──────────────────────────────────────────────────────
plot(basis, "Basis", color.orange, 1)
plot(upper, "Upper", color.teal, 1)
plot(lower, "Lower", color.red, 1)

// ATR stop lines: shown only while in position and when the stop is enabled
plot(useStop_i and strategy.position_size > 0 ? longStop : na,
     "ATR Stop Long", color=color.red, style=plot.style_linebr, linewidth=2)
plot(useStop_i and strategy.position_size < 0 ? shortStop : na,
     "ATR Stop Short", color=color.red, style=plot.style_linebr, linewidth=2)

plotshape(longBreak, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Break")
plotshape(shortBreak, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Break")
plotshape(stopHitLong or stopHitShort, style=shape.xcross, location=location.top, color=color.gray, size=size.tiny, title="ATR Stop")
